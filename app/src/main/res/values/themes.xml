<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Material 3 app theme. DayNight = light by default, dark when night mode is on. -->
    <style name="Base.Theme.Campusmate" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/md_inverse_primary</item>

        <!-- System bars match the screen -->
        <item name="android:statusBarColor">@color/md_surface</item>
        <item name="android:navigationBarColor">@color/md_surface_container</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>

        <!-- Poppins everywhere -->
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Campusmate.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Campusmate.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Campusmate.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Campusmate.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Campusmate.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Campusmate.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Campusmate.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Campusmate.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Campusmate.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Campusmate.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Campusmate.LabelSmall</item>

        <!-- 16 dp rounded cards, inputs and buttons -->
        <item name="materialCardViewStyle">@style/Widget.Campusmate.Card</item>
        <item name="textInputStyle">@style/Widget.Campusmate.TextInput</item>
        <item name="materialButtonStyle">@style/Widget.Campusmate.Button</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Campusmate.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Campusmate.Large</item>

        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.Campusmate.Activity</item>
    </style>

    <style name="Theme.Campusmate" parent="Base.Theme.Campusmate" />

    <!-- Splash screen (Android 12 style, back-ported to older phones by core-splashscreen) -->
    <style name="Theme.Campusmate.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_teal</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Campusmate</item>
    </style>

    <style name="Animation.Campusmate.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out_short</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in_short</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="ShapeAppearance.Campusmate.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Campusmate.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.Campusmate.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="Widget.Campusmate.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius</item>
    </style>

    <style name="Widget.Campusmate.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius</item>
    </style>

    <style name="Widget.Campusmate.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Campusmate.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Campusmate.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Small coloured pill: LOST / FOUND / RETURNED / Pending ... -->
    <style name="Widget.Campusmate.Badge" parent="">
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Text styles -->
    <style name="TextAppearance.Campusmate.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>
    <style name="TextAppearance.Campusmate.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>
    <style name="TextAppearance.Campusmate.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>
    <style name="TextAppearance.Campusmate.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>
    <style name="TextAppearance.Campusmate.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>
    <style name="TextAppearance.Campusmate.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>
    <style name="TextAppearance.Campusmate.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>
    <style name="TextAppearance.Campusmate.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>
    <style name="TextAppearance.Campusmate.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>
    <style name="TextAppearance.Campusmate.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>
    <style name="TextAppearance.Campusmate.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>
</resources>
