<?xml version="1.0" encoding="utf-8"?>
<!-- Hidden demo menu (long-press the logo on Home) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_l">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_l"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/space_l"
            android:paddingBottom="@dimen/space_s"
            android:text="@string/demo_menu_title"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <TextView
            android:id="@+id/accounts_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_l"
            android:paddingEnd="@dimen/space_l"
            android:paddingBottom="@dimen/space_s"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
